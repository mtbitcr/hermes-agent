# Names of the journeys test stack on Server 2. Names only: no value, no address, no key.
#
# Format: plain text, one name per line, "#" comments, [sections].
# reset_stack.sh and isolation_check.sh take every container, volume and variable name from
# this file and refuse anything that is not listed here.
# Every container below needs a Docker health check: the reset waits on it and nothing else.
#
# The ORDER of [containers] and [volumes] is the role of each entry, and the scripts check
# the roles against the [env ...] sections and the mounts before they change anything:
#   [containers]  1 sign-in proxy, 2 owner app, 3 dashboard, 4 gateway, 5 browser
#   [volumes]     1 platform home, 2 owner app token files, 3 proxy keys (reset never touches it)

[containers]
raphael-journeys-proxy
raphael-journeys-app
raphael-journeys-dashboard
raphael-journeys-gateway
raphael-journeys-browser

[volumes]
raphael-journeys-home
raphael-journeys-tokens
raphael-journeys-proxy

# Names allowed in the .env file of each platform profile (the default one and the planner).
# No messaging platform name is allowed here.
[home-env]
API_SERVER_KEY
ANTHROPIC_TOKEN
CLAUDE_CODE_OAUTH_TOKEN

# Per container: variable names beyond the ones its image sets itself.

[env raphael-journeys-proxy]
SYNTHETIC_STATE

# The owner app has no GitHub names and no page check name; those belong to production.
[env raphael-journeys-app]
HERMES_API_BASE_URL
HERMES_CONVERSATION_API_BASE_URL
HERMES_API_TOKEN_FILE
HERMES_RECOMMENDATIONS_TOKEN_FILE
HERMES_CONNECTIONS_API_TOKEN_FILE
HERMES_AUTOMATIONS_API_TOKEN_FILE
HERMES_MODELS_API_TOKEN_FILE
HERMES_EXECUTOR_API_TOKEN_FILE
HERMES_PLANNER_API_TOKEN_FILE
NODE_EXTRA_CA_CERTS
NODE_ENV
PORT
RAPHAEL_ACCESS_AUDIENCE
RAPHAEL_ACCESS_ISSUER
RAPHAEL_OWNER_MEMBERSHIP_JSON
RAPHAEL_OWNER_TIME_ZONE
RAPHAEL_PROJECT_BINDINGS_JSON
RAPHAEL_PUBLIC_ORIGIN
RAPHAEL_PLANNER_MODEL
RAPHAEL_EXECUTOR_MODEL

[env raphael-journeys-dashboard]
HERMES_HOME

[env raphael-journeys-gateway]
HERMES_HOME

[env raphael-journeys-browser]
JOURNEY_BASE_URL
JOURNEY_PRODUCTION_ORIGIN
PLAYWRIGHT_BROWSERS_PATH

# Variables the two scripts read from their own environment on the host (set by the operator).
[script-input]
JOURNEY_STACK_HOST
JOURNEY_PRODUCTION_ORIGIN
JOURNEY_MODEL_TOKEN_FILE

# Server 1 only, for the issuer check: read, never changed.
[production-container]
raphael-workspace

[production-read-variable]
RAPHAEL_ACCESS_ISSUER

# Fixed settings for the .env file of the default profile. No value is kept in the repository.
# reset_stack.sh installs this file as .env, because .gitignore ignores any file named .env,
# and then adds the values it makes on Server 2: API_SERVER_KEY and, when a model token file
# is given, CLAUDE_CODE_OAUTH_TOKEN. Allowed names: [home-env] in stack.env.template.
